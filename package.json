{
  "name": "argue-ai",
  "version": "0.2.1",
  "description": "Several AI models (Claude, GPT, Gemini, …) argue it out; you get one carefully vetted answer. Works from Claude Code, Codex, Cursor, Pi, OpenCode or the terminal.",
  "type": "module",
  "bin": {
    "argue": "bin/argue.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "instructions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/unit.test.js test/integration.test.js test/instructions/instructions.test.js",
    "lint": "npm i --no-save eslint@9 @eslint/js@9 globals@16 prettier@3 && eslint src bin test scripts && prettier --check src bin test scripts",
    "format": "npx -y prettier@3 --write src bin test",
    "instructions:preview": "node scripts/preview-instructions.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "agents",
    "coding-agent",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor",
    "opencode",
    "pi",
    "mcp",
    "multi-agent",
    "debate",
    "code-review",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jassi2004/argue.git"
  },
  "homepage": "https://github.com/Jassi2004/argue#readme",
  "bugs": "https://github.com/Jassi2004/argue/issues",
  "author": "Jaskirat Singh"
}
